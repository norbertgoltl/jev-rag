# Live Jev smoke configuration template.
# Copy to .env only if it does not exist; otherwise merge the required values.
# Set TYPESAFE_API_KEY to your real server-side key in .env, never in this template.
# Run: JEV_LIVE_SMOKE=1 make jev-smoke
# This sends a potentially billable external request. Docker is not required.
# Never execute this file as shell code.
APP_ENV=development
APP_DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:3000"]
QDRANT_URL=http://127.0.0.1:6333
QDRANT_TIMEOUT_SECONDS=1.0
JEV_MODE=live
# TYPESAFE_API_KEY is only required in explicit live mode.
TYPESAFE_API_KEY=

COMPOSE_PROJECT_NAME=jev-rag
QDRANT_HOST_PORT=6333

# Jev live mode must be explicitly selected. Never expose this key to the frontend.
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_TIMEOUT_SECONDS=5.0
TYPESAFE_RETRY_MAX=1
TYPESAFE_RETRY_BUDGET_SECONDS=10.0
