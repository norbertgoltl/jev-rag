# Backend configuration. Infrastructure and Jev integration follow in later tasks.
# Copy to .env for local overrides. Never execute this file as shell code.
APP_ENV=development
APP_DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:3000"]
QDRANT_URL=http://127.0.0.1:6333
QDRANT_TIMEOUT_SECONDS=1.0
JEV_MODE=mock
# TYPESAFE_API_KEY is only required in explicit live mode.
TYPESAFE_API_KEY=
