# Backend and local infrastructure configuration.
# Copy to .env for local overrides. Never execute this file as shell code.
APP_ENV=development
APP_DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:3000"]
QDRANT_URL=http://127.0.0.1:6333
QDRANT_TIMEOUT_SECONDS=1.0
JEV_MODE=mock
# TYPESAFE_API_KEY is only required in explicit live mode.
TYPESAFE_API_KEY=

COMPOSE_PROJECT_NAME=jev-rag
QDRANT_HOST_PORT=6333

# Jev live mode must be explicitly selected. Never expose this key to the frontend.
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_TIMEOUT_SECONDS=5.0
TYPESAFE_RETRY_MAX=1
TYPESAFE_RETRY_BUDGET_SECONDS=10.0

# Document ingestion (disabled by default). Paths default to data/ingestion under the repository root.
# Enabling ingestion requires an embedding provider and model, which are not implemented yet.
INGESTION_ENABLED=false
# INGESTION_STORAGE_ROOT=
# INGESTION_DB_PATH=
INGESTION_MAX_FILE_BYTES=26214400
INGESTION_ALLOWED_EXTENSIONS=[".txt", ".md", ".pdf", ".docx"]
INGESTION_MAX_CONCURRENT_JOBS=1
INGESTION_JOB_LEASE_SECONDS=300
INGESTION_CHUNK_TARGET_TOKENS=400
INGESTION_CHUNK_OVERLAP_TOKENS=64
INGESTION_EMBEDDING_PROVIDER=none
# INGESTION_EMBEDDING_MODEL=
INGESTION_EMBEDDING_BATCH_SIZE=16
INGESTION_QDRANT_COLLECTION=rag_chunks_v1
INGESTION_ALLOW_REMOTE_EMBEDDING=false
